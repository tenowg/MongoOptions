{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**/*.csproj"
          ],
          "src": "../"
        }
      ],
      "dest": "api",
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "bin/**"
        ]
      },
      {
        "files": [
          "api/**.yml"
        ],
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_disableNavbar": false,
      "_appName": "Tenowg.MongoOptions",
      "_appTitle": "MongoOptions Documentation",
      "_appLogoPath": "images/mongooptions-64.webp",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/tenowg/MongoOptions",
        "branch": "master"
      },
      "_gitUrlPattern": "github",
      "_repoUrl": "https://github.com/tenowg/MongoOptions"
    },
    "sitemap": {
      "baseUrl": "https://tenowg.github.io/MongoOptions",
      "priority": 0.1,
      "changefreq": "monthly"
    }
  }
}