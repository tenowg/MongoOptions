<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Tenowg.MongoOptions</PackageId>
    <Version>1.0.0</Version>
    <Authors>Craig Russell</Authors>
	<PackageProjectUrl>https://github.com/tenowg/MongoOptions</PackageProjectUrl>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<RepositoryUrl>https://github.com/tenowg/MongoOptions</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
    <Description>A resilient, keyed configuration provider using MongoDB and IMemoryCache.</Description>
    <PackageTags>mongodb;dotnet10;options;configuration;csharp14</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

    <ItemGroup>
	    <None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
    </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="MongoDB.Driver" Version="3.6.0" />
  </ItemGroup>

</Project>